# LOCAL: copie este arquivo para .env e gere sua SECRET_KEY.
APP_ENV=development
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
DATABASE_URL=sqlite:///easy-servicos.db
# PRODUÇÃO: use APP_ENV=production e a URL PostgreSQL do Supabase.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres?sslmode=require
# Login inicial: não há senha padrão. Defina uma senha forte (12–128 caracteres).
ADMIN_USERNAME=diogo
ADMIN_NAME=Diogo
ADMIN_PASSWORD=
# Fotos opcionais (armazenadas como privadas): copie a URL do painel Cloudinary.
CLOUDINARY_URL=
# Opcional, para rate limit compartilhado. Sem Redis, mantenha um worker Gunicorn.
REDIS_URL=
